  {
    "slug": "gulf-war",
    "title": "Война в Персидском заливе",
    "lat": 29.0,
    "lon": 47.5,
    "region": "Ближний Восток",
    "country": "Кувейт",
    "severity": "global",
    "status": "resolved",
